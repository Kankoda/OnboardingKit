{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"OnboardingKit has intro views that can be used to welcome users to your app, for instance on the first app launch. They show an app icon, a title, an optional text, and a list of the most important features of your app.","type":"text"}]},{"type":"heading","level":2,"anchor":"Intro-Screen","text":"Intro Screen"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingIntroScreen","type":"reference"},{"text":" can be used to present a stand-alone screen, or as a page in a flow like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPageView","type":"reference"},{"text":":","type":"text"}]},{"type":"row","columns":[{"content":[{"inlineContent":[{"type":"image","identifier":"OnboardingIntroScreen"}],"type":"paragraph"}],"size":1},{"content":[{"code":["OnboardingIntroScreen(","    icon: Image(.appIcon),","    welcomeTitle: \"Welcome to\",","    title: \"My App\",","    text: \"My App helps you do amazing things.\",","    usps: [","        .init(","            title: \"Fast\",","            text: \"My App is **really** fast.\",","            image: Image(systemName: \"bolt\")","        ),","        .init(","            title: \"Private\",","            text: \"Your data never leaves your device.\",","            image: Image(systemName: \"lock\")","        )","    ]",")",".onboardingIntroStyle(...)"],"type":"codeListing","syntax":"swift"}],"size":3}],"numberOfColumns":4},{"type":"paragraph","inlineContent":[{"text":"The screen wraps an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingIntroView","type":"reference"},{"text":" in a scroll view and an ","type":"text"},{"isActi