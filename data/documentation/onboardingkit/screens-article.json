{"metadata":{"modules":[{"name":"OnboardingKit"}],"roleHeading":"API Collection","title":"Screens","role":"collectionGroup"},"seeAlsoSections":[{"identifiers":["doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/Pages-Article","doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/Flows-Article","doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/USPs-Article","doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/WhatsNew-Article","doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/Views-Article"],"title":"Features","anchor":"Features","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/onboardingkit\/screens-article"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"OnboardingKit has several screen templates that can be used to mimic many native onboarding experiences. These screens use views from other features.","type":"text"}]},{"level":2,"text":"System Screens","type":"heading","anchor":"System-Screens"},{"type":"paragraph","inlineContent":[{"text":"OnboardingKit has system screen templates that aim to fit into the Apple ecosystem. Use these to achieve a clean, informative design, that feels like Apple’s own screens.","type":"text"}]},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingWelcomeScreen","isActive":true,"type":"reference"},{"text":" can be used to present a stand-alone screen, or as a page in a flow like ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPageFlow","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"row","numberOfColumns":5,"columns":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"OnboardingWelcomeScreen"}]}],"size":2},{"content":[{"code":["OnboardingWelcomeScreen(","    icon: Image(.appIcon),","    welcomeTitle: \"Welcome to\",","    title: \"My App\",","    text: \"My App helps you do amazing things.\",","    usps: [","        .init(","            title: \"Fast\",","            text: \"My App is **really** fast.\",","            image: Image(systemName: \"bolt\")","        ),","        .init(","            title: \"Private\",","            text: \"Your data never leaves your device.\",","            image: Image(systemName: \"lock\")","        )","    ]",")",".onboardingWelcomeScreenStyle(...)"],"syntax":"swift","type":"codeListing"}],"size":3}]},{"inlineContent":[{"text":"The screen content is centered by default, but you can apply ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/SwiftUICore\/View\/onboardingWelcomeScreenAlignment(_:)","isActive":true,"type":"reference"},{"text":" with ","type":"text"},{"code":".leading","type":"codeVoice"},{"text":" to leading-align it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This is a good, first screen to show in a welcome onboarding. See the ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/Getting-Started-Article","isActive":true,"type":"reference"},{"text":" article for more information on how to create your own welcome onboarding.","type":"text"}],"type":"paragraph"}],"title":"Welcome Screen"},{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingWhatsNewScreen","isActive":true,"type":"reference"},{"text":" can be used to present the items in an ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingWhatsNewInfo","isActive":true,"type":"reference"},{"text":" as a stand-alone screen, or as a page in a flow like ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPageFlow","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"row","numberOfColumns":5,"columns":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"OnboardingWhatsNewScreen"}]}],"size":2},{"content":[{"code":["OnboardingWhatsNewScreen(","    info: info,","    header: {","        VStack {","            Image.logo","            Text(\"What's New\")","                .font(.largeTitle)","            ...","        }","    },","    footer: {","        Text(\"Thank you for using OnboardingKit!\")","    },","    item: { item in","        OnboardingUspListItem(usp: item.usp)","    }",")",".onboardingWhatsNewScreenStyle(...)"],"syntax":"swift","type":"codeListing"},{"code":["OnboardingWhatsNewScreen(","    info: info",") { item in","    Label {","        Text(item.text)","    } icon: {","        item.icon","    }","}"],"syntax":"swift","type":"codeListing"}],"size":3}]},{"inlineContent":[{"text":"Unlike the more basic ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingWelcomeScreen","isActive":true,"type":"reference"},{"text":", this screen is more versatile, and supports a custom header and footer view. See the ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/WhatsNew-Article","isActive":true,"type":"reference"},{"text":" article for more information about how to define and present what’s new.","type":"text"}],"type":"paragraph"}],"title":"What's New Screen"},{"content":[{"inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPromoScreen","type":"reference","isActive":true},{"type":"text","text":" can be used to promote a feature, an offer or a service, with a large top image and a call to action:"}],"type":"paragraph"},{"numberOfColumns":5,"columns":[{"content":[{"inlineContent":[{"type":"image","identifier":"OnboardingPromoScreen"}],"type":"paragraph"}],"size":2},{"content":[{"syntax":"swift","type":"codeListing","code":["OnboardingPromoScreen(","    image: Image(.promo),","    title: \"1 year of My App Pro\",","    text: \"Unlock all features and support the development.\",","    footerText: \"12 months free, then $4.99\/month.\",","    buttonText: \"Enjoy 1 Year Free\",","    buttonAction: { ... }",")",".onboardingPromoScreenStyle(...)"]}],"size":3}],"type":"row"},{"type":"paragraph","inlineContent":[{"text":"The image fills the full screen width and extends into the top safe area, while the footer text and button are pushed to the bottom of the screen. The screen scrolls if the content doesn’t fit.","type":"text"}]}],"title":"Promo Screen"}]},{"level":2,"text":"Stylized Screens","type":"heading","anchor":"Stylized-Screens"},{"type":"paragraph","inlineContent":[{"text":"OnboardingKit also has more stylized screen templates that aim to express a unique style for your app. Use these to create a stunning first impression that feels right at home in your app.","type":"text"}]},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingCoverScreen","isActive":true,"type":"reference"},{"type":"text","text":" can be used to welcome users to the app, with a leading-aligned icon, title and text on top of a full-screen background:"}],"type":"paragraph"},{"columns":[{"content":[{"inlineContent":[{"type":"image","identifier":"OnboardingCoverScreen-HealthierYou"}],"type":"paragraph"}],"size":2},{"content":[{"syntax":"swift","type":"codeListing","code":["OnboardingCoverScreen(","    icon: Image(.appIcon),","    title: \"A Healthier\\nYou Awaits\",","    text: \"Personalized workouts and progress tracking...\",","    backgroundImage: Image(.cover)",")",".onboardingCoverScreenStyle(...)"]}],"size":3}],"type":"row","numberOfColumns":5},{"inlineContent":[{"type":"text","text":"The cover screen has very little text and no USPs, and should deliver an elevator pitch for your app that triggers the user to give it a try."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You can provide an optional ","type":"text"},{"code":"footerImage","type":"codeVoice"},{"text":" to show an image below the text, for instance an illustration or a product screenshot. The image is scaled to fit the remaining space, and is aligned to the bottom of the screen.","type":"text"}]}],"title":"Cover Screen"}]},{"level":2,"text":"Screen Content","type":"heading","anchor":"Screen-Content"},{"type":"paragraph","inlineContent":[{"text":"All screens wrap their content in a scroll view and an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPageContent"},{"text":", and fade out the content above the page indicator when used in an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPageFlow"},{"text":". You can also their nested content views as standalone views.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPromoScreen","type":"reference","isActive":true},{"text":" is an exception, since it has a full-width image and its own bottom button. It’s intended to be presented as a stand-alone screen, rather than as a page in a flow.","type":"text"}]},{"level":2,"text":"Localization","type":"heading","anchor":"Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All screens are use "},{"code":"LocalizedStringResource","type":"codeVoice"},{"text":" values, which means that they string catalogs, keyed resources and markdown.","type":"text"}]},{"level":2,"text":"Styling","type":"heading","anchor":"Styli