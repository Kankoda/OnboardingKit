een","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingWhatsNewScreen","isActive":true},{"type":"text","text":", and is a good fit for custom pages in flows like "},{"type":"reference","identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPageView","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingSlideshow","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The page content can be styled with an "},{"type":"reference","identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPageContentStyle","isActive":true},{"type":"text","text":", which is applied with "},{"type":"reference","identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/SwiftUICore\/View\/onboardingPageContentStyle(_:)","isActive":true},{"type":"text","text":". It defines the max width and height of the content."}]},{"level":2,"anchor":"Primary-Button","type":"heading","text":"Primary Button"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPrimaryButton","isActive":true},{"type":"text","text":" is a large, full-width button that can be used for the main actions of an onboarding, for instance at the bottom of a flow:"}]},{"type":"codeListing","code":["OnboardingPrimaryButton(\"Continue\") {","    state.showNextPage(orDismiss: dismiss)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use an "},{"type":"reference","identifier":"doc:\/\/src.OnboardingKit\/documentation\/OnboardingKit\/OnboardingPrimaryButtonType","isActive":true},{"type":"text","text":" to make the button "},{"type":"codeVoice","code":".primary"},{"type":"text","text"